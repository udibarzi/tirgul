/**
 * Tirgul practice tracking — Google Apps Script web app.
 *
 * Paste this whole file into Extensions → Apps Script of the "tirgul" Google Sheet.
 * See _tracking/SETUP.md for the steps. This file holds no secrets: the keys are
 * generated by setup() into Script Properties and never leave your Google account,
 * except inside the two links that showLinks() prints for you.
 */

// After Deploy → New deployment, paste the "Web app URL" here (it ends with /exec), save, then run showLinks.
var WEB_APP_URL = '';

var TZ = 'Asia/Jerusalem';
var EVENT_COLS = ['id', 'ts', 'learner', 'type', 'topic', 'level', 'mode', 'kind', 'item', 'correct', 'given', 'seconds', 'received'];
var LEARNER_COLS = ['name', 'grade', 'gender', 'minutesPerWeek', 'daysPerWeek', 'active'];
var EVENT_TYPES = { time: 1, answer: 1, card: 1, session: 1 };
var PRACTICE_DAY_SECONDS = 300;
var MAX_RANGE_DAYS = 84;
var MAX_EVENTS_PER_POST = 500;
var SITE = 'https://udibarzi.github.io/tirgul/';

// ---------- run these by hand from the editor ----------

/** Creates the tabs, sets the time zone and makes the two keys. Safe to run again. */
function setup() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  ss.setSpreadsheetTimeZone(TZ);
  var ev = ss.getSheetByName('events') || ss.insertSheet('events');
  if (ev.getLastRow() === 0) {
    ev.getRange('A:M').setNumberFormat('@');   // keep typed answers and times as plain text
    ev.appendRow(EVENT_COLS);
    ev.setFrozenRows(1);
  }
  var ls = ss.getSheetByName('learners') || ss.insertSheet('learners');
  if (ls.getLastRow() === 0) {
    ls.appendRow(LEARNER_COLS);
    ls.setFrozenRows(1);
  }
  var props = PropertiesService.getScriptProperties();
  if (!props.getProperty('WRITE_KEY')) props.setProperty('WRITE_KEY', randomKey_());
  if (!props.getProperty('PARENT_KEY')) props.setProperty('PARENT_KEY', randomKey_());
}

/** Prints the two setup links. Run after Deploy → New deployment → Web app. */
function showLinks() {
  // Run from the editor, getUrl() often returns the /dev address, which only works for you
  var url = String(WEB_APP_URL || '').trim() || ScriptApp.getService().getUrl();
  if (!/^https:\/\/script\.google\.com\/.+\/exec$/.test(url)) {
    Logger.log('Missing web app URL. Deploy → Manage deployments → copy the "Web app URL" that ends with /exec, ' +
      'paste it between the quotes in the line WEB_APP_URL = \'\' at the top of this file, save, and run showLinks again.');
    return;
  }
  var props = PropertiesService.getScriptProperties();
  var dev = SITE + '#setup=' + b64_({ url: url, key: props.getProperty('WRITE_KEY') });
  var par = SITE + 'app/report.html#setup=' + b64_({ url: url, key: props.getProperty('PARENT_KEY') });
  Logger.log('Device link — open once on each girl\'s phone or tablet:\n' + dev);
  Logger.log('Parent link — open on your own phone, keep it private:\n' + par);
}

/** Adds one test row, to check that writing works. */
function ping() {
  appendEvents_([{ id: 'ping-' + Utilities.getUuid(), ts: new Date().toISOString(), learner: 'test', type: 'session', topic: 'ping' }]);
}

// ---------- web app ----------

function doPost(e) {
  try { return handlePost_(e); } catch (err) { return json_({ ok: false, error: 'server', message: String(err && err.message || err).slice(0, 200) }); }
}

function doGet(e) {
  try { return handleGet_(e); } catch (err) { return json_({ ok: false, error: 'server', message: String(err && err.message || err).slice(0, 200) }); }
}

function handlePost_(e) {
  var body;
  try { body = JSON.parse(e.postData.contents); } catch (err) { return json_({ ok: false, error: 'bad' }); }
  var role = role_(body && body.key);
  if (!role) return json_({ ok: false, error: 'key' });

  if (body.action === 'setGoal') {
    if (role !== 'parent') return json_({ ok: false, error: 'key' });
    return json_(setGoal_(body));
  }
  if (!Array.isArray(body.events)) return json_({ ok: false, error: 'bad' });
  return json_(appendEvents_(body.events.slice(0, MAX_EVENTS_PER_POST)));
}

function handleGet_(e) {
  var p = (e && e.parameter) || {};
  var role = role_(p.key);
  if (!role) return json_({ ok: false, error: 'key' });

  if (p.action === 'learners') return json_({ ok: true, learners: readLearners_() });
  if (p.action === 'week') {
    var learner = String(p.learner || '');
    var mine = readEvents_().filter(function (x) { return x.learner === learner; });
    var s = weekSummary(mine, learner, currentWeekStart_());
    return json_({ ok: true, minutes: s.minutes, days: s.days });
  }
  if (p.action === 'events') {
    if (role !== 'parent') return json_({ ok: false, error: 'key' });
    var from = String(p.from || ''), to = String(p.to || '');
    var span = daysBetween_(from, to);
    if (span === null || span < 0 || span > MAX_RANGE_DAYS) return json_({ ok: false, error: 'range' });
    var evs = readEvents_().filter(function (x) { var d = dayOf_(x.ts); return d >= from && d <= to; });
    return json_({ ok: true, events: evs });
  }
  return json_({ ok: false, error: 'action' });
}

// ---------- summaries ----------

/** Goal minutes and practice days for one learner in the week starting on weekStart (a Sunday, yyyy-MM-dd). */
function weekSummary(events, learner, weekStart) {
  var end = addDays_(weekStart, 7);
  var perDay = {};
  events.forEach(function (x) {
    if (x.learner !== learner || x.type !== 'time' || x.topic === 'menu') return;
    var d = dayOf_(x.ts);
    if (d < weekStart || d >= end) return;
    perDay[d] = (perDay[d] || 0) + (Number(x.seconds) || 0);
  });
  var total = 0, days = 0;
  Object.keys(perDay).forEach(function (d) { total += perDay[d]; if (perDay[d] >= PRACTICE_DAY_SECONDS) days++; });
  return { minutes: Math.floor(total / 60), days: days };
}

// ---------- internals ----------

function role_(key) {
  if (!key) return null;
  var props = PropertiesService.getScriptProperties();
  if (key === props.getProperty('PARENT_KEY')) return 'parent';
  if (key === props.getProperty('WRITE_KEY')) return 'write';
  return null;
}

function clip_(v, n) { return String(v === undefined || v === null ? '' : v).slice(0, n); }

// Text that starts like a formula is stored with a leading apostrophe, so the sheet never evaluates it
function safe_(s) { return /^[=+\-@]/.test(s) ? "'" + s : s; }
function unsafe_(s) { s = String(s); return /^'[=+\-@]/.test(s) ? s.slice(1) : s; }

function cleanEvent_(x) {
  if (!x || typeof x.id !== 'string' || !x.id || x.id.length > 64) return null;
  var t = new Date(x.ts);
  if (isNaN(t.getTime())) return null;
  var learner = clip_(x.learner, 40).trim();
  if (!learner || !EVENT_TYPES[x.type]) return null;
  var correct = x.correct === 1 || x.correct === '1' ? 1 : x.correct === 0 || x.correct === '0' ? 0 : '';
  var seconds = Number(x.seconds) > 0 ? Math.min(Math.round(Number(x.seconds)), 86400) : '';
  return [safe_(x.id), t.toISOString(), safe_(learner), x.type, safe_(clip_(x.topic, 80)), safe_(clip_(x.level, 20)), safe_(clip_(x.mode, 20)),
    safe_(clip_(x.kind, 30)), safe_(clip_(x.item, 200)), correct, safe_(clip_(x.given, 60)), seconds, new Date().toISOString()];
}

function appendEvents_(events) {
  var lock = LockService.getScriptLock();
  try { lock.waitLock(20000); } catch (err) { return { ok: false, error: 'busy' }; }
  try {
    var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('events');
    var last = sh.getLastRow();
    var seen = {};
    if (last > 1) sh.getRange(2, 1, last - 1, 1).getValues().forEach(function (r) { seen[safe_(unsafe_(r[0]))] = true; });
    var rows = [], saved = [], dup = [], bad = [];
    events.forEach(function (x) {
      var row = cleanEvent_(x);
      if (!row) { if (x && typeof x.id === 'string') bad.push(x.id); return; }
      if (seen[row[0]]) { dup.push(x.id); return; }
      seen[row[0]] = true;
      rows.push(row);
      saved.push(x.id);
    });
    if (rows.length) {
      // A new tab has only 1,000 rows, and setValues does not add rows by itself
      var need = last + rows.length - sh.getMaxRows();
      if (need > 0) sh.insertRowsAfter(sh.getMaxRows(), need + 500);
      var range = sh.getRange(last + 1, 1, rows.length, EVENT_COLS.length);
      range.setNumberFormat('@');
      range.setValues(rows);
    }
    return { ok: true, saved: saved, dup: dup, bad: bad };
  } finally {
    lock.releaseLock();
  }
}

function readEvents_() {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('events');
  var last = sh.getLastRow();
  if (last < 2) return [];
  return sh.getRange(2, 1, last - 1, EVENT_COLS.length).getValues().map(function (r) {
    var o = {};
    EVENT_COLS.forEach(function (c, i) { o[c] = r[i]; });
    ['id', 'learner', 'topic', 'level', 'mode', 'kind', 'item', 'given'].forEach(function (c) { o[c] = unsafe_(o[c]); });
    o.ts = o.ts instanceof Date ? o.ts.toISOString() : String(o.ts);
    o.correct = o.correct === '' ? '' : Number(o.correct);
    o.seconds = o.seconds === '' ? '' : Number(o.seconds);
    delete o.received;
    return o;
  });
}

function isActive_(v) {
  if (v === false) return false;
  return !/^(false|no|0|לא)$/i.test(String(v).trim());
}

function readLearners_() {
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('learners');
  var last = sh.getLastRow();
  if (last < 2) return [];
  return sh.getRange(2, 1, last - 1, LEARNER_COLS.length).getValues()
    .filter(function (r) { return String(r[0]).trim() && isActive_(r[5]); })
    .map(function (r) {
      var o = { name: String(r[0]).trim(), grade: Number(r[1]) || 0, gender: String(r[2]).trim() === 'male' ? 'male' : 'female' };
      if (Number(r[3]) > 0) o.minutesPerWeek = Number(r[3]);
      if (Number(r[4]) > 0) o.daysPerWeek = Number(r[4]);
      return o;
    });
}

function setGoal_(b) {
  var m = Number(b.minutesPerWeek), d = Number(b.daysPerWeek);
  if (!(m >= 0 && m <= 3000) || !(d >= 0 && d <= 7)) return { ok: false, error: 'bad' };
  var sh = SpreadsheetApp.getActiveSpreadsheet().getSheetByName('learners');
  var last = sh.getLastRow();
  if (last < 2) return { ok: false, error: 'learner' };
  var names = sh.getRange(2, 1, last - 1, 1).getValues();
  for (var i = 0; i < names.length; i++) {
    if (String(names[i][0]).trim() === String(b.learner)) {
      sh.getRange(i + 2, 4, 1, 2).setValues([[Math.round(m), Math.round(d)]]);
      return { ok: true };
    }
  }
  return { ok: false, error: 'learner' };
}

function dayOf_(ts) { return Utilities.formatDate(new Date(ts), TZ, 'yyyy-MM-dd'); }

function currentWeekStart_() {
  var now = new Date();
  var dow = Number(Utilities.formatDate(now, TZ, 'u')) % 7;   // Sunday → 0
  return addDays_(dayOf_(now), -dow);
}

function ymdToUtc_(s) {
  var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(String(s));
  return m ? Date.UTC(Number(m[1]), Number(m[2]) - 1, Number(m[3])) : null;
}

function addDays_(ymd, n) {
  var d = new Date(ymdToUtc_(ymd) + n * 86400000);
  return d.getUTCFullYear() + '-' + ('0' + (d.getUTCMonth() + 1)).slice(-2) + '-' + ('0' + d.getUTCDate()).slice(-2);
}

function daysBetween_(a, b) {
  var x = ymdToUtc_(a), y = ymdToUtc_(b);
  return x === null || y === null ? null : Math.round((y - x) / 86400000);
}

function randomKey_() { return (Utilities.getUuid() + Utilities.getUuid()).replace(/-/g, '').slice(0, 32); }

function b64_(obj) { return Utilities.base64EncodeWebSafe(JSON.stringify(obj), Utilities.Charset.UTF_8); }

function json_(obj) { return ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON); }

if (typeof module !== 'undefined') module.exports = { doGet: doGet, doPost: doPost, setup: setup, showLinks: showLinks, ping: ping, weekSummary: weekSummary };
