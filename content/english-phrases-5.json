{
  "id": "english-phrases-5",
  "name": "אנגלית — משפטים לשיחה",
  "icon": "💬",
  "version": "1.0.0",
  "type": "vocab",
  "questionsPerSession": 20,
  "sentences": [
    { "en": "Hello, how are you?", "he": "שלום, מה שלומך?" },
    { "en": "I'm fine, thank you.", "he": "אני בסדר, תודה." },
    { "en": "What's your name?", "he": "איך קוראים לך?" },
    { "en": "How old are you?", "he": "בן כמה אתה? / בת כמה את?" },
    { "en": "I am eleven years old.", "he": "אני בן / בת אחת עשרה." },
    { "en": "Where do you live?", "he": "איפה אתה גר? / איפה את גרה?" },
    { "en": "I live in Israel.", "he": "אני גר / גרה בישראל." },
    { "en": "What do you like to do?", "he": "מה אתה אוהב לעשות? / מה את אוהבת לעשות?" },
    { "en": "I like to play with my friends.", "he": "אני אוהב / אוהבת לשחק עם החברים שלי." },
    { "en": "What's your favorite food?", "he": "מה האוכל האהוב עליך?" },
    { "en": "My favorite food is pizza.", "he": "האוכל האהוב עליי הוא פיצה." },
    { "en": "Do you have a brother or a sister?", "he": "יש לך אח או אחות?" },
    { "en": "I have one brother and two sisters.", "he": "יש לי אח אחד ושתי אחיות." },
    { "en": "Can you help me, please?", "he": "אפשר עזרה, בבקשה?" },
    { "en": "Thank you very much.", "he": "תודה רבה." },
    { "en": "You're welcome.", "he": "בבקשה / על לא דבר." },
    { "en": "I don't understand.", "he": "אני לא מבין / מבינה." },
    { "en": "Can you say it again, please?", "he": "אפשר להגיד את זה שוב, בבקשה?" },
    { "en": "Let's play together!", "he": "בואו נשחק ביחד!" },
    { "en": "See you tomorrow!", "he": "נתראה מחר!" },
    { "en": "Good morning!", "he": "בוקר טוב!" },
    { "en": "Have a nice day!", "he": "שיהיה לך יום נעים!" },
    { "en": "Excuse me.", "he": "סליחה." },
    { "en": "What time is it?", "he": "מה השעה?" },
    { "en": "It's my birthday today!", "he": "היום יום ההולדת שלי!" }
  ]
}
