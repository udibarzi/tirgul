{
  "id": "english-phrases-8",
  "name": "אנגלית — ביטויים לשיחה",
  "icon": "💬",
  "version": "1.0.0",
  "type": "vocab",
  "questionsPerSession": 20,
  "sentences": [
    { "en": "How's it going?", "he": "מה קורה? / איך הולך?" },
    { "en": "Not bad, thanks.", "he": "לא רע, תודה." },
    { "en": "How was your weekend?", "he": "איך היה סוף השבוע שלך?" },
    { "en": "What have you been up to?", "he": "מה עשית בזמן האחרון?" },
    { "en": "It was really fun.", "he": "היה ממש כיף." },
    { "en": "In my opinion, it's a great idea.", "he": "לדעתי, זה רעיון מצוין." },
    { "en": "What do you think about it?", "he": "מה דעתך על זה?" },
    { "en": "I totally agree with you.", "he": "אני מסכים / מסכימה איתך לגמרי." },
    { "en": "I'm not sure about that.", "he": "אני לא בטוח / בטוחה בזה." },
    { "en": "I see what you mean.", "he": "אני מבין / מבינה את הכוונה." },
    { "en": "That makes sense.", "he": "זה הגיוני." },
    { "en": "What do you mean?", "he": "מה הכוונה?" },
    { "en": "Could you repeat that, please?", "he": "אפשר לחזור על זה, בבקשה?" },
    { "en": "Sorry, I didn't catch that.", "he": "סליחה, לא קלטתי." },
    { "en": "To be honest, I don't like it.", "he": "האמת, אני לא אוהב / אוהבת את זה." },
    { "en": "I'd rather stay at home.", "he": "אני מעדיף / מעדיפה להישאר בבית." },
    { "en": "Let me think about it.", "he": "תן / תני לי לחשוב על זה." },
    { "en": "It depends.", "he": "זה תלוי." },
    { "en": "That sounds great!", "he": "נשמע מעולה!" },
    { "en": "I can't wait!", "he": "מחכה בקוצר רוח!" },
    { "en": "No way!", "he": "אין מצב!" },
    { "en": "Never mind.", "he": "לא משנה." },
    { "en": "Same here.", "he": "גם אצלי אותו דבר." },
    { "en": "Good luck!", "he": "בהצלחה!" },
    { "en": "Take care!", "he": "שמור / שמרי על עצמך!" }
  ]
}
