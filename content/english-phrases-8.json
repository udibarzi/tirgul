  "words": [
    { "en": "How's it going?", "he": "מה קורה? / איך הולך?", "group": "question" },
    { "en": "Not bad, thanks.", "he": "לא רע, תודה.", "group": "say" },
    { "en": "How was your weekend?", "he": "איך היה סוף השבוע שלך?", "group": "question" },
    { "en": "What have you been up to?", "he": "מה עשית בזמן האחרון?", "group": "question" },
    { "en": "It was really fun.", "he": "היה ממש כיף.", "group": "say" },
    { "en": "In my opinion, it's a great idea.", "he": "לדעתי, זה רעיון מצוין.", "group": "say" },
    { "en": "What do you think about it?", "he": "מה דעתך על זה?", "group": "question" },
    { "en": "I totally agree with you.", "he": "אני מסכים / מסכימה איתך לגמרי.", "group": "say" },
    { "en": "I'm not sure about that.", "he": "אני לא בטוח / בטוחה בזה.", "group": "say" },
    { "en": "I see what you mean.", "he": "אני מבין / מבינה את הכוונה.", "group": "say" },
    { "en": "That makes sense.", "he": "זה הגיוני.", "group": "say" },
    { "en": "What do you mean?", "he": "מה הכוונה?", "group": "question" },
    { "en": "Could you repeat that, please?", "he": "אפשר לחזור על זה, בבקשה?", "group": "question" },
    { "en": "Sorry, I didn't catch that.", "he": "סליחה, לא קלטתי.", "group": "say" },
    { "en": "To be honest, I don't like it.", "he": "האמת, אני לא אוהב / אוהבת את זה.", "group": "say" },
    { "en": "I'd rather stay at home.", "he": "אני מעדיף / מעדיפה להישאר בבית.", "group": "say" },
    { "en": "Let me think about it.", "he": "תן / תני לי לחשוב על זה.", "group": "say" },
    { "en": "It depends.", "he": "זה תלוי.", "group": "say" },
    { "en": "That sounds great!", "he": "נשמע מעולה!", "group": "say" },
    { "en": "I can't wait!", "he": "מחכה בקוצר רוח!", "group": "say" },
    { "en": "No way!", "he": "אין מצב!", "group": "say" },
    { "en": "Never mind.", "he": "לא משנה.", "group": "say" },
    { "en": "Same here.", "he": "גם אצלי אותו דבר.", "group": "say" },
    { "en": "Good luck!", "he": "בהצלחה!", "group": "say" },
    { "en": "Take care!", "he": "שמור / שמרי על עצמך!", "group": "say" }
  ]
