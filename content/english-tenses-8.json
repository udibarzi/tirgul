    { "en": "I was sleeping when you called.", "he": "ישנתי כשהתקשרת.", "blank": "was sleeping", "choices": ["slept", "am sleeping", "sleep"] },
    { "en": "Tomorrow it will be sunny.", "he": "מחר יהיה שמשי.", "blank": "will be", "choices": ["was", "is being", "were"] },
