    { "en": "They are playing football right now.", "he": "הם משחקים כדורגל עכשיו.", "blank": "are playing", "choices": ["played", "plays", "play"] },
    { "en": "Did you finish the test?", "he": "סיימת את המבחן?", "blank": "Did", "choices": ["Do", "Does", "Are"] },
    { "en": "We didn't go to school yesterday.", "he": "לא הלכנו לבית הספר אתמול.", "blank": "didn't go", "choices": ["don't go", "didn't went", "doesn't go"] },
    { "en": "My brother always forgets his keys.", "he": "אחי תמיד שוכח את המפתחות.", "blank": "forgets", "choices": ["forget", "forgot", "forgetting"] },
